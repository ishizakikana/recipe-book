{
    "all": true,
    "include": [
        "src/components/**/components/**/*.tsx",
        "src/components/ui/**/*.tsx",
        "src/components/layout/**/*.tsx"
    ],
    "exclude": [
        "src/**/*.stories.*",
        "src/**/*.test.*",
        "src/**/*.spec.*",
        "**/hooks/**",
        "**/utils/**",
        "**/types.ts",
        "**/util.ts"
    ],
    "reporter": [
        "text",
        "lcov",
        "html"
    ],
    "report-dir": "coverage",
    "temp-dir": ".nyc_output",
    "check-coverage": false
}